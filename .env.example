# Copy to .env and fill in only what you want to use.
# WanderEar works fully offline with NONE of these set.

# --- Local model (Gemma via Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
WANDEREAR_MODEL=gemma3:4b

# --- Local data location (optional) ---
# WANDEREAR_HOME=~/.local/share/wanderear

# --- Local web app (optional) ---
# HOST=127.0.0.1
# PORT=8000

# --- Real classifier (optional) ---
# WANDEREAR_YAMNET_DIR=./data/models

# --- Cloud multipliers (all optional) ---
# WANDEREAR_MONGO_URI=mongodb+srv://...
# SENTRY_DSN=https://...
# WANDEREAR_SYNC_TOKEN=change-me   # protects the hosted gallery's write endpoints
# RENDER_API_KEY=...
# DIGITALOCEAN_TOKEN=...